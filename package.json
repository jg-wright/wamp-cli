{
  "name": "wamp-cli",
  "version": "4.2.2",
  "description": "A CLI for testing WAMP connections",
  "type": "module",
  "bin": {
    "wampc": "src/program.js"
  },
  "author": "John Wright <johngeorge.wright@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/jg-wright/wamp-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jg-wright/wamp-cli.git"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "clean": "rimraf src/*.{js,d.ts}",
    "test": "node --test test/**/*.test.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "autobahn": "^26.0.0",
    "cli-table": "^0.3.11",
    "colors": "^1.4.0",
    "commander": "^15.0.0",
    "tslib": "^2.8.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/autobahn": "20.9.4",
    "@types/cli-table": "0.3.4",
    "@types/node": "26.6.6",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{md,json,js,jsx,ts,tsx,yml,yaml}": [
      "npx prettier --ignore-path .gitignore --write"
    ]
  }
}
